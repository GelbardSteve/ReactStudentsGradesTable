DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stevegel_students
PORT=4000

# Resend (https://resend.com). Leave RESEND_API_KEY empty in dev to print emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Base URL of the React app, used in the email verification link
APP_URL=http://localhost:3000

# AI assistant (Gemini). Free key: https://aistudio.google.com/apikey. Leave empty to disable the assistant.
GEMINI_API_KEY=
AI_MODEL=google:gemini-3.5-flash-lite
# Max chat messages per admin per minute
AI_RATE_LIMIT_PER_MIN=20
# CopilotKit sends anonymous usage telemetry unless this is set
COPILOTKIT_TELEMETRY_DISABLED=true
